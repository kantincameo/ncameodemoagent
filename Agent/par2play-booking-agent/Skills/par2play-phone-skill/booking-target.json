{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Par2Play Booking Record",
  "type": "object",
  "properties": {
    "bookingId": {
      "type": "string",
      "description": "Unique booking identifier"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Booking date in YYYY-MM-DD format"
    },
    "startTime": {
      "type": "string",
      "pattern": "^([0-1][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Start time in HH:MM format (24-hour)"
    },
    "endTime": {
      "type": "string",
      "pattern": "^([0-1][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "End time in HH:MM format (24-hour)"
    },
    "numberOfGolfers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Number of golfers in the party"
    },
    "resourceId": {
      "type": "string",
      "description": "Golf course resource identifier (e.g., 'course-1-hole-1-4')"
    },
    "paymentMethod": {
      "type": "string",
      "enum": ["Confirmed"],
      "description": "Payment method is always set to 'Confirmed' - actual payment processing is handled separately"
    },
    "membershipInstanceIdUsed": {
      "type": "null",
      "description": "No membership discounts are applied. Always null."
    },
    "customerPackageIdUsed": {
      "type": "null",
      "description": "No package credits are applied. Always null."
    },
    "creditsDeducted": {
      "type": "integer",
      "const": 0,
      "description": "No credits are deducted. Always 0."
    },
    "amountCharged": {
      "type": "number",
      "minimum": 0,
      "description": "Full slot price without discounts"
    },
    "specialRequests": {
      "type": ["string", "null"],
      "description": "Any special requests from the customer (e.g., equipment needs, course preferences)"
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "cancelled"],
      "description": "Current booking status"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when booking was created"
    }
  },
  "required": [
    "bookingId",
    "date",
    "startTime",
    "endTime",
    "numberOfGolfers",
    "resourceId",
    "paymentMethod",
    "amountCharged",
    "status"
  ]
}
